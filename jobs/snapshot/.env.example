# Copie para .env e preencha. Não versione o .env (ele tem chaves).
# Descrição de cada variável: README.md, seção 3.

# --- Azure SQL Database (origem) ---
SQL_SERVER=meuservidor.database.windows.net
SQL_DATABASE=meubanco
# Tabelas separadas por vírgula, no formato schema.tabela (sem schema = dbo)
TABELAS=dbo.Vendas,dbo.Clientes

# Autenticação no banco: usuário SQL...
SQL_USER=
SQL_PASSWORD=
# ...ou service principal do Entra ID (usado se SQL_USER estiver vazio)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Supabase (destino) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=snapshots

# --- Opcionais (vazio = valor padrão) ---
PREFIXO=dataflow
FUSO=America/Fortaleza
DATA_SNAPSHOT=
# SQL_DRIVER=ODBC Driver 18 for SQL Server
