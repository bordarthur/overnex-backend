# Copie para .env (que não vai para o git) e preencha. Só para enviar ao Storage: com
# `--saida pasta`, o gerador não precisa de nada disto.

SUPABASE_URL=
# Chave secret do projeto (a mesma do snapshot e da carga).
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=overnex-bucket

# Opcionais (vazio = padrão)
PREFIXO_DEMO=
FUSO=
DATA_SNAPSHOT=
