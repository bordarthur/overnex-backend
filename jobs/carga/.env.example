# Copie para .env (que não vai para o git) e preencha. Descrição de cada variável: README.md.

# Role carga. Local: senha definida pelo supabase/seed.sql.
# Produção: pooler do Supabase em MODO SESSÃO (porta 5432 do pooler), usuário carga.<project-ref>.
DATABASE_URL_CARGA=postgresql://carga:carga_local@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# Chave secret do projeto. Local: "Secret key" do `supabase status`.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=overnex-bucket

# Opcionais (vazio = padrão)
EXIGIR_SNAPSHOT_NOVO=false
DATA_ESPERADA=
