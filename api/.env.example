# Copie para .env (que não vai para o git). Nada aqui é segredo.

# Conexão do role api_site.
# Local (supabase start): senha definida pelo supabase/seed.sql.
# Produção: pooler do Supabase em modo transação (porta 6543), usuário api_site.<project-ref>.
DATABASE_URL=postgresql://api_site:api_site_local@127.0.0.1:54322/postgres

# Microsoft Entra ID (app registration da API)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# dev | homolog | prod  (sem valor = prod)
AMBIENTE=dev

# Usuário fake (Authorization: Bearer fake:<object_id_entra>). Só funciona com AMBIENTE=dev;
# em qualquer outro ambiente a API se recusa a iniciar.
AUTH_FAKE=1

# DB_POOL_MIN=1
# DB_POOL_MAX=10
