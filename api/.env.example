# Copie para .env (que não vai para o git). Nada aqui é segredo; os valores secretos ficam
# vazios e só entram no seu .env.

# Conexão do role api_site.
# Local (supabase start): senha definida pelo supabase/seed.sql.
# Produção: pooler do Supabase em modo transação (porta 6543), usuário api_site.<project-ref>.
DATABASE_URL=postgresql://api_site:api_site_local@127.0.0.1:54322/postgres

# Login: supabase (e-mail e senha, padrão) | entra (Microsoft Entra ID, desligado por enquanto)
AUTH_PROVEDOR=supabase

# Supabase Auth (obrigatórios com AUTH_PROVEDOR=supabase).
# URL do projeto: Project Settings → Data API. Produção: https://ddpicszgihwekcvyevmd.supabase.co
# Os JWTs são validados pelo JWKS público do projeto ({SUPABASE_URL}/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://ddpicszgihwekcvyevmd.supabase.co
# Chave publishable (sb_publishable_…), em Project Settings → API Keys. Não é segredo, mas
# só a API usa: o front não fala com o Supabase.
SUPABASE_ANON_KEY=
# Base dos links dos e-mails de convite e de recuperação ({FRONT_URL}/definir-senha).
FRONT_URL=http://localhost:5173

# Cookie do refresh token com Secure. Obrigatório fora de dev; em dev, false permite testar
# em http://localhost.
COOKIE_SEGURO=false
# Max-Age do cookie do refresh token, em segundos (padrão 7 dias; cada renovação recomeça).
# AUTH_REFRESH_SEGUNDOS=604800

# Só o CLI de cadastro (python -m app.cli.convidar_usuario) usa as duas abaixo. Nunca as
# coloque no ambiente da API publicada.
# Chave secreta (sb_secret_…) ou service_role legada: Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão como postgres (ignora o RLS), para gravar seg.usuario e os vínculos.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_ADMIN=

# Microsoft Entra ID (app registration da API). Só com AUTH_PROVEDOR=entra.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# dev | homolog | prod  (sem valor = prod)
AMBIENTE=dev

# Usuário fake (Authorization: Bearer fake:<id_autenticacao>). Só funciona com AMBIENTE=dev;
# em qualquer outro ambiente a API se recusa a iniciar.
AUTH_FAKE=1

# Visão geral com seções fictícias (as do mockup), para o front testar a tela completa
# contra a API local. Só funciona com AMBIENTE=dev. Sem ela, as seções vêm vazias até as
# regras dos indicadores existirem.
VISAO_GERAL_DEMO=1

# Segundos que a resposta pronta da Visão geral fica em memória (padrão 900; 0 desliga).
# A chave inclui a última carga: carga nova troca a resposta na hora.
# VISAO_GERAL_CACHE_SEGUNDOS=900

# Conexões do pool. A Visão geral usa até 3 por requisição (seções em paralelo).
# DB_POOL_MIN=3
# DB_POOL_MAX=20
