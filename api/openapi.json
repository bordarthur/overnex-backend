    "/api/telas/fin-01": {
      "get": {
        "tags": [
          "telas"
        ],
        "summary": "Fin 01",
        "operationId": "fin_01_api_telas_fin_01_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "mes",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "AAAA-MM. Sem valor: último mês com dados.",
              "title": "Mes"
            },
            "description": "AAAA-MM. Sem valor: último mês com dados."
          },
          {
            "name": "empresa",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Empresa (precisa estar no vínculo do usuário).",
              "title": "Empresa"
            },
            "description": "Empresa (precisa estar no vínculo do usuário)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreenPayload"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Acesso negado."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dados/{tabela}": {
      "get": {
        "tags": [
          "dados"
        ],
        "summary": "Ler Tabela",
        "operationId": "ler_tabela_api_dados__tabela__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tabela",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "description": "Tabela de dados do mart.",
              "title": "Tabela"
            },
            "description": "Tabela de dados do mart."
          },
          {
            "name": "apos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Devolve as linhas com _linha maior que este valor.",
              "default": 0,
              "title": "Apos"
            },
            "description": "Devolve as linhas com _linha maior que este valor."
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "default": 1000,
              "title": "Limite"
            }
          },
          {
            "name": "empresa",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opcional: só esta empresa (precisa estar no vínculo do usuário).",
              "title": "Empresa"
            },
            "description": "Opcional: só esta empresa (precisa estar no vínculo do usuário)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DadosPayload"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Acesso negado."
          },
          "404": {
            "description": "Tabela registrada, mas ainda não criada no banco."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
